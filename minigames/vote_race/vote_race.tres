[resource]
script = ExtResource("1")
id = &"vote_race"
display_name = "Vote Race"
rules_text = "Everyone stands on a 5-step track to the cashier. Each round, secretly vote for one other racer (8 seconds). Everyone with ZERO votes steps forward; then the votes are revealed. First to step 5 wins, the rest finish in order. The race ends when only 2 racers are left. Requires 4+ players."
