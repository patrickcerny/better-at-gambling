[resource]
script = ExtResource("1")
id = &"jackpot_climb"
display_name = "Jackpot Climb"
rules_text = "Hop up the chip stacks to the JACKPOT sign. Each giant chip tier has a checkpoint flag: fall off and you come back at your last flag. Round every tier pick the steady side or the bold side with a few long jumps. E swings your bat to knock climbers off. First to the top wins, the rest rank by height."
