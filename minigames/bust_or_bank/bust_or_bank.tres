[resource]
script = ExtResource("1")
id = &"bust_or_bank"
display_name = "Bust or Bank"
rules_text = "Blackjack round the table, in elimination rounds. Each round everyone still in gets one card, then it goes turn by turn: you have 20 s to HIT (take one card, the next player goes) or STAND (your hand is locked). The next card is face down: every hit is a gamble. Over 21 = bust. After each round everyone who busted is out; if nobody busted, the lowest hand is out (ties go out together, unless that would be everyone: then play again). Last player in wins."
logic_script = ExtResource("2")
stage_script = ExtResource("3")
min_players = 2
weight = 1.0
