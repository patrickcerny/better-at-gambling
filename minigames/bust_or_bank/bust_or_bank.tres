[resource]
script = ExtResource("1")
id = &"bust_or_bank"
display_name = "Bust or Bank"
rules_text = "Blackjack round the table. Everyone gets one card, then it goes turn by turn: you have 20 s to HIT (take one card, the next player goes) or STAND (your hand is locked). Everyone sees the NEXT card face up. Over 21 = bust. When everyone has stood or busted, the highest hand wins."
