[resource]
script = ExtResource("1")
id = &"forehead_poker"
display_name = "Forehead Poker"
rules_text = "Everyone wears a card on their forehead: you see all cards but your own. Talk it over, then 1 = STAY or 2 = FOLD (no answer folds). The highest staying card (aces high, suits don't count) wins +1 per stayer, other stayers lose 1, folding scores 0; equal top cards split the pot, rounded down. 5 rounds."
